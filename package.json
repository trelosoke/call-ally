{
  "name": "call-ally",
  "version": "1.0.0",
  "description": "CallAlly é um site que permite a criação e gestão de chamados, seja de tarefas ou problemas a resolver no dia a dia.",
  "keywords": [
    "helpdesk",
    "tickets",
    "management",
    "typescript",
    "dom"
  ],
  "homepage": "https://github.com/trelosoke/call-ally#readme",
  "bugs": {
    "url": "https://github.com/trelosoke/call-ally/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trelosoke/call-ally.git"
  },
  "license": "MIT",
  "author": "Diogo da Silva <diogoviniciussilva.dev@gmail.com>",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "server": "node --import tsx backend/server.ts",
    "pserver": "nodemon --ext ts --exec \"node --import tsx backend/server.ts\"",
    "studio": "node scripts/prisma-studio.mjs"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "prisma": "^7.10.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vite": "^8.1.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "better-sqlite3@13.0.3": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.0": true
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
